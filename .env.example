# pgmcp configuration. Copy to .env and edit; every value here is a default.
# Command-line flags take precedence over these, which take precedence over
# the built-in defaults. Full reference: https://github.com/shamalawy/pgmcp

# -------------------------------------------------------------- Connection --
# libpq connection string. Falls back to DATABASE_URL, then PG* variables.
# REQUIRED. Also accepted as DATABASE_URL, or assembled from PG* variables.
PGMCP_DSN=postgresql://postgres:postgres@localhost:5432/postgres

# Value reported in pg_stat_activity.application_name.
PGMCP_APPLICATION_NAME=pgmcp

# Connect timeout in seconds.
PGMCP_CONNECT_TIMEOUT=10

PGMCP_POOL_MIN_SIZE=1

PGMCP_POOL_MAX_SIZE=5

# Seconds to wait for a free pooled connection.
PGMCP_POOL_TIMEOUT=30.0

# Seconds an idle pooled connection is kept before closing.
PGMCP_POOL_MAX_IDLE=300.0


# ------------------------------------------------------------------ Safety --
# read-only hides every mutating tool; write enables them.
PGMCP_ACCESS_MODE=read-only

# Per-statement timeout applied with SET LOCAL on every query.
PGMCP_STATEMENT_TIMEOUT_MS=30000

# Hard cap on rows returned by any single tool call.
PGMCP_MAX_ROWS=500

# Byte budget for a serialised result; output is truncated to fit.
PGMCP_MAX_RESULT_BYTES=1000000

# Reject SQL longer than this many characters.
PGMCP_MAX_QUERY_LENGTH=200000

# If non-empty, only these schemas are visible. Comma-separated in env vars.
# PGMCP_ALLOWED_SCHEMAS=

# Schemas hidden from every tool, in addition to allowed_schemas filtering.
# PGMCP_BLOCKED_SCHEMAS=

# Expose pg_catalog/information_schema in listings by default.
PGMCP_INCLUDE_SYSTEM_SCHEMAS=false

# If non-empty, cross-database tool calls are limited to these names.
# PGMCP_ALLOWED_DATABASES=

# Permit tools to target a database other than the one in the DSN.
PGMCP_ALLOW_CROSS_DATABASE=true

# Which tool groups to register. Comma-separated in env vars.
PGMCP_ENABLED_TOOLSETS=schema,query,health,write


# ------------------------------------------------------------------ Output --
PGMCP_DEFAULT_FORMAT=json

# Row limit used when a tool call does not supply one.
PGMCP_DEFAULT_ROW_LIMIT=100


# --------------------------------------------------------------- Transport --
PGMCP_TRANSPORT=stdio

# Bind address for HTTP transports.
PGMCP_HOST=127.0.0.1

PGMCP_PORT=8000

# URL path for the streamable-http endpoint.
PGMCP_MOUNT_PATH=/mcp

# Return plain JSON instead of SSE framing on streamable-http.
PGMCP_JSON_RESPONSE=false

# Run streamable-http without server-side session state.
PGMCP_STATELESS_HTTP=false

PGMCP_LOG_LEVEL=INFO

# -------------------------------------------------------------------- Tests --
# Used by the integration test suite only.
# PGMCP_TEST_DSN=postgresql://postgres:postgres@localhost:5433/pgmcp_demo
# PGMCP_WRITE_TEST_DSN=postgresql://postgres:postgres@localhost:5433/pgmcp_write
